NODE_ENV=development
PORT=3000
CLUSTER_WORKERS=

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=postgres
PG_DATABASE=wallet
PG_LOGGER=false
PG_SYNCHRONIZE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

AUTH_JWT_SECRET=dev-only-demo-secret

RABBITMQ_URL=amqp://guest:guest@localhost:5672
DEPOSIT_EXCHANGE=deposit_exchange
DEPOSIT_ROUTING_KEY=deposit.created

RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

IDEMPOTENCY_LOCK_TTL_SECONDS=60
IDEMPOTENCY_RESULT_TTL_SECONDS=86400

TRANSACTIONS_PAGE_CACHE_TTL_SECONDS=30

REPORTS_DIR=./storage/reports
